# TTS Lab desktop credentials. Keep this file private; values are stored as plain text.
# Configure via Model configuration > click a cloud service card > Save.
# Saved credentials apply immediately and are never read back into the dialog.
# Only configure services you want to use. No provider APIs are called at startup.
OPENAI_API_KEY=
# DeepSeek official standalone TTS API; no chat model name is required.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
MIMO_API_KEY=
# Doubao Voice new-console API Key; not the Ark chat API key.
VOLCENGINE_TTS_API_KEY=
STEP_API_KEY=
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=

# AWS Polly SDK is bundled. Either select an existing local AWS profile:
# AWS_PROFILE=default
# Or configure credentials you already have:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=us-east-1
