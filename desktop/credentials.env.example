# TTS Lab desktop credentials. Keep this file private; values are stored as plain text.
# Edit via File > Edit API credentials, save, then restart the app.
# Only configure services you want to use. No cloud calls happen at startup.
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=

# AWS Polly SDK is bundled. Either select an existing local AWS profile:
# AWS_PROFILE=default
# Or configure credentials you already have:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=us-east-1
