; Definitions and the exact payload cleanup list are generated by build_installer.py.
Unicode true
RequestExecutionLevel user
ManifestDPIAware true
SetCompressor /SOLID lzma
SetCompressorDictSize 32
Name "TTS Lab"
OutFile "${INSTALLER_PATH}"
InstallDir "$LOCALAPPDATA\Programs\TTS Lab"
InstallDirRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\TTS Lab" "InstallLocation"
BrandingText "TTS Lab"
ShowInstDetails show
ShowUninstDetails show
VIProductVersion "${WINDOWS_VERSION}"
VIAddVersionKey /LANG=2052 "ProductName" "TTS Lab"
VIAddVersionKey /LANG=2052 "FileDescription" "TTS Lab 安装程序"
VIAddVersionKey /LANG=2052 "FileVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=2052 "LegalCopyright" "TTS Lab contributors"

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
!include "WinVer.nsh"

!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\TTS Lab"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TITLE "欢迎安装 TTS Lab"
!define MUI_WELCOMEPAGE_TEXT "安装后可从开始菜单打开语音测试工作台。$\r$\n$\r$\n仅为当前用户安装，无需管理员权限。Python 与应用依赖已包含在安装包内。$\r$\n$\r$\n请先退出正在运行的 TTS Lab。升级和卸载会保留已保存的方案、凭证、本地模型与历史音频。"
!define MUI_FINISHPAGE_RUN "$INSTDIR\TTS Lab.exe"
!define MUI_FINISHPAGE_RUN_TEXT "启动 TTS Lab"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH
!insertmacro MUI_LANGUAGE "SimpChinese"

Function .onInit
  SetShellVarContext current
  ; Match InstallDirRegKey's bootstrap view (read before .onInit), so upgrades
  ; also rediscover custom install paths. Windows lists both uninstall views.
  SetRegView 32
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "TTS Lab 需要 Windows 10/11 x64。" /SD IDOK
    SetErrorLevel 1
    Quit
  ${EndIf}
  ${IfNot} ${AtLeastWin10}
    MessageBox MB_OK|MB_ICONSTOP "TTS Lab 需要 Windows 10/11 x64。" /SD IDOK
    SetErrorLevel 1
    Quit
  ${EndIf}
FunctionEnd

Function un.onInit
  SetShellVarContext current
  SetRegView 32
FunctionEnd

; Opening the installed executable with no sharing detects a running app without
; killing processes or interrupting its pending generation/download tasks.
!macro CHECK_APP_CLOSED PREFIX
Function ${PREFIX}CheckAppClosed
  retry:
  IfFileExists "$INSTDIR\TTS Lab.exe" 0 done
  System::Call 'kernel32::CreateFileW(w "$INSTDIR\TTS Lab.exe", i 0xC0000000, i 0, p 0, i 3, i 0, p 0) p.r0'
  ${If} $0 == -1
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "无法修改应用文件。请退出 TTS Lab，并确认安装目录可写，然后重试。" /SD IDCANCEL IDRETRY retry
    SetErrorLevel 1
    Abort
  ${EndIf}
  System::Call 'kernel32::CloseHandle(p r0)'
  done:
FunctionEnd
!macroend
!insertmacro CHECK_APP_CLOSED ""
!insertmacro CHECK_APP_CLOSED "un."

Section "TTS Lab（必选）" MainSection
  SectionIn RO
  Call CheckAppClosed
  ; The old uninstaller removes only its known payload. This also removes files
  ; which disappeared in the newer version, while preserving unrelated files.
  ReadRegStr $1 HKCU "${UNINSTALL_KEY}" "InstallLocation"
  ${If} $1 == $INSTDIR
    IfFileExists "$INSTDIR\Uninstall.exe" 0 copy_payload
    ; NSIS consumes the entire remaining command line after _?= as its directory.
    ; It must stay last and unquoted, including for paths with spaces.
    ExecWait '"$INSTDIR\Uninstall.exe" /S _?=$INSTDIR' $0
    ${If} $0 != 0
      MessageBox MB_OK|MB_ICONSTOP "旧版本卸载未完成，安装已停止。请关闭 TTS Lab 后重试。" /SD IDOK
      SetErrorLevel 1
      Abort
    ${EndIf}
  ${EndIf}
  copy_payload:
  SetOutPath "$INSTDIR"
  ClearErrors
  File /r "${BUNDLE_FILES}"
  IfErrors 0 write_registration
    MessageBox MB_OK|MB_ICONSTOP "应用文件复制失败，请检查磁盘空间与目录权限后重新安装。" /SD IDOK
    SetErrorLevel 1
    Abort
  write_registration:
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "TTS Lab"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "Publisher" "TTS Lab"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\TTS Lab.exe"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegStr HKCU "${UNINSTALL_KEY}" "QuietUninstallString" '$\"$INSTDIR\Uninstall.exe$\" /S'
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "EstimatedSize" ${INSTALLED_KB}
  CreateDirectory "$SMPROGRAMS\TTS Lab"
  CreateShortcut "$SMPROGRAMS\TTS Lab\TTS Lab.lnk" "$INSTDIR\TTS Lab.exe"
  CreateShortcut "$SMPROGRAMS\TTS Lab\卸载 TTS Lab.lnk" "$INSTDIR\Uninstall.exe"
  SetErrorLevel 0
SectionEnd

Section /o "创建桌面快捷方式" DesktopShortcut
  CreateShortcut "$DESKTOP\TTS Lab.lnk" "$INSTDIR\TTS Lab.exe"
SectionEnd

Section "Uninstall"
  Call un.CheckAppClosed
  ; Change the working directory before removing the now-empty installation dir.
  SetOutPath "$TEMP"
  !include "${UNINSTALL_PAYLOAD}"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  ReadRegStr $1 HKCU "${UNINSTALL_KEY}" "InstallLocation"
  ${If} $1 == $INSTDIR
    Delete "$SMPROGRAMS\TTS Lab\TTS Lab.lnk"
    Delete "$SMPROGRAMS\TTS Lab\卸载 TTS Lab.lnk"
    RMDir "$SMPROGRAMS\TTS Lab"
    Delete "$DESKTOP\TTS Lab.lnk"
    DeleteRegKey HKCU "${UNINSTALL_KEY}"
  ${EndIf}
  ; Deliberately no operation on $LOCALAPPDATA\TTS Lab (credentials/data/models).
  SetErrorLevel 0
SectionEnd
